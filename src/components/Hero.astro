---
import ThreeScene from './islands/ThreeScene.tsx';
---

<section id="top" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="relative z-10 w-full max-w-6xl mx-auto px-5 pt-24 pb-16 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div data-reveal>
      <p class="silkscreen trace mb-4">
      </p>
      <h1 class="font-display text-4xl md:text-6xl leading-tight font-bold tracking-tight">
        Arif Rijal Fadhilah
      </h1>
      <p class="silkscreen copper mt-4">→ Embedded Systems Engineer &amp; IoT Developer</p>
      <p class="mt-6 text-text-secondary max-w-xl leading-relaxed">
        Bridging the gap between hardware and software. Specializing in microcontrollers, real-time
        control systems, and robust IoT architectures for industrial and consumer applications.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#projects" class="chip-card px-5 py-3 text-trace no-underline">View Projects <i data-lucide="arrow-right" class="inline-block h-4 w-4"></i></a>
        <a href="https://github.com/Arifrijalf" target="_blank" rel="noopener" class="chip-card px-5 py-3 no-underline">GitHub</a>
        <a href="#contact" id="download-cv-btn" class="chip-card px-5 py-3 text-copper no-underline">Download CV</a>
      </div>
      <p class="silkscreen mt-10 text-text-secondary">
        // 00.719&deg;S 100.342&deg;E — PADANG, INDONESIA
      </p>
    </div>
    <div data-reveal data-reveal-delay="1" class="relative">
      <div class="corner-brackets"></div>
      <ThreeScene client:only="react" />
    </div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px trace-line opacity-40"></div>
</section>
