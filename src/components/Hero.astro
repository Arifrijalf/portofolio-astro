---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile-photo.jpg';
---

<section
  class="min-h-screen pt-[120px] pb-section-padding px-margin-page flex items-center"
  id="home"
>
  <div
    class="max-w-container-max mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center"
  >
    {/* Left: Info */}
    <div class="col-span-1 lg:col-span-6 space-y-8 z-10">
      <div
        class="inline-block px-4 py-1.5 rounded-full border border-border-muted bg-surface-container-low/50 backdrop-blur-sm"
      >
        <span
          class="font-label-caps text-label-caps text-secondary-fixed flex items-center gap-2"
        >
          <span
            class="w-2 h-2 rounded-full bg-secondary-fixed animate-pulse"
          ></span>
          Portofolio
        </span>
      </div>
      <div class="space-y-4">
        <h1 class="font-headline-xl text-headline-xl text-text-primary">
          Arif Rijal Fadhilah
        </h1>
        <h2 class="font-headline-md text-headline-md text-text-secondary">
          Embedded Systems Engineer <br />
          & IoT Developer
        </h2>
      </div>
      <p class="font-body-lg text-body-lg text-text-secondary max-w-xl">
        Bridging the gap between hardware and software. Specializing in
        microcontrollers, real-time control systems, and robust IoT
        architectures for industrial and consumer applications.
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <a
          class="glow-btn-primary px-8 py-3 rounded-card font-body-md text-body-md flex items-center gap-2"
          href="#projects"
        >
          View Projects
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
        <a
          class="px-8 py-3 rounded-card border border-border-muted text-text-primary hover:border-primary/50 hover:bg-surface-container-low transition-all font-body-md text-body-md flex items-center gap-2"
          href="https://github.com/Arifrijalf"
          target="_blank"
        >
          <span class="material-symbols-outlined text-sm">code</span>
          GitHub
        </a>
        <button
          id="download-cv-btn"
          class="px-8 py-3 rounded-card border border-border-muted text-text-primary hover:border-primary/50 hover:bg-surface-container-low transition-all font-body-md text-body-md flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-sm">download</span>
          Download CV
        </button>
      </div>
    </div>
    {/* Right: Profile Photo */}
    <div
      class="col-span-1 lg:col-span-6 mt-12 lg:mt-0 relative flex justify-center items-center"
    >
      <div class="profile-photo-container">
        <div class="profile-photo-frame slideshow" id="hero-slideshow">
          <Image
            src={profilePhoto}
            alt="Arif Rijal Fadhilah"
            class="profile-photo-img slide active"
            decoding="async"
            loading="eager"
            width={420}
            height={560}
            widths={[210, 320, 420, 630]}
            sizes="(max-width: 640px) 280px, (max-width: 1024px) 360px, 420px"
          />
          <video
            src="/video1.mp4"
            alt="Arif Rijal Fadhilah in project demo 1"
            class="profile-photo-img slide"
            playsinline
            muted
            preload="auto"
          ></video>
          <video
            src="/video2.mp4"
            alt="Arif Rijal Fadhilah in project demo 2"
            class="profile-photo-img slide"
            playsinline
            muted
            preload="auto"
          ></video>
        </div>
      </div>
    </div>
  </div>
</section>