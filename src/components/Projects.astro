---
import { Image } from 'astro:assets';
import incubator from '../assets/project-incubator.jpg';
import iotDashboard from '../assets/project-iot-dashboard.jpg';
import energyMonitor from '../assets/project-energy-monitor.jpg';

const projects = [
  {
    title: "Smart Baby Incubator with PID Control",
    description: "Developed a high-precision temperature regulation system for neonatal care. Implemented advanced PID algorithms on an ESP32 to maintain constant thermal environments with less than 0.2°C variance.",
    image: incubator,
    alt: "Smart baby incubator prototype with PID control display",
    tags: [
      { label: "C++", color: "text-primary" },
      { label: "PID", color: "text-secondary-fixed" }
    ]
  },
  {
    title: "ESP32 IoT Monitoring Dashboard",
    description: "Full-stack IoT solution. Engineered the firmware for distributed ESP32 sensor nodes communicating via MQTT, and built a real-time React dashboard to visualize environmental metrics and manage device states.",
    image: iotDashboard,
    alt: "IoT monitoring dashboard with real-time data visualization",
    tags: [
      { label: "ESP32", color: "text-primary" },
      { label: "MQTT", color: "text-secondary-fixed" }
    ]
  },
  {
    title: "Smart Energy Monitoring System",
    description: "Designed custom PCB architecture using KiCad for a multi-channel AC/DC energy monitor. Utilized STM32 for high-speed ADC sampling and power factor calculations, providing real-time analytics to reduce industrial power waste.",
    image: energyMonitor,
    alt: "Custom PCB designed for energy monitoring system",
    tags: [
      { label: "STM32", color: "text-primary" },
      { label: "KiCad", color: "text-secondary-fixed" }
    ]
  }
];
---

<section class="py-section-padding px-margin-page relative" id="projects">
  <div class="max-w-container-max mx-auto">
    <div class="mb-12">
      <h2 class="font-headline-lg text-headline-lg text-text-primary mb-4 flex items-center gap-4">
        <span class="material-symbols-outlined text-primary text-4xl">memory</span>
        Featured Engineering
      </h2>
      <div class="w-24 h-1 bg-primary rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div class="glass-card hover-lift overflow-hidden group flex flex-col h-full">
          <div class="h-48 relative overflow-hidden bg-surface-container border-b border-border-muted">
            <Image
              src={project.image}
              alt={project.alt}
              width={400}
              height={192}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
            />
            <div class="absolute top-4 right-4 flex gap-2">
              {project.tags.map((tag) => (
                <span class={`px-2 py-1 bg-surface-card/90 backdrop-blur border border-border-muted rounded text-[10px] font-label-caps ${tag.color}`}>
                  {tag.label}
                </span>
              ))}
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="font-headline-md text-[22px] text-text-primary mb-2 group-hover:text-primary transition-colors">
              {project.title}
            </h3>
            <p class="font-body-md text-[14px] text-text-secondary mb-6 flex-grow">
              {project.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>