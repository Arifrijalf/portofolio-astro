---
import { Image } from 'astro:assets';
import projectIncubator from '../assets/project-incubator.jpg';
import projectIotDashboard from '../assets/project-iot-dashboard.jpg';
import projectEnergyMonitor from '../assets/project-energy-monitor.jpg';

const projects = [
  {
    name: 'Smart Baby Incubator with PID Control',
    description:
      'Developed a high-precision temperature regulation system for neonatal care. Implemented advanced PID algorithms on an ESP32 to maintain constant thermal environments with less than 0.2°C variance.',
    tags: ['C++', 'PID'],
    image: projectIncubator,
    alt: 'Smart baby incubator prototype with PID control display',
    id: 'INC-01',
  },
  {
    name: 'ESP32 IoT Monitoring Dashboard',
    description:
      'Full-stack IoT solution. Engineered the firmware for distributed ESP32 sensor nodes communicating via MQTT, and built a real-time React dashboard to visualize environmental metrics and manage device states.',
    tags: ['ESP32', 'MQTT'],
    image: projectIotDashboard,
    alt: 'IoT monitoring dashboard with real-time data visualization',
    id: 'MON-02',
  },
  {
    name: 'Smart Energy Monitoring System',
    description:
      'Designed custom PCB architecture using KiCad for a multi-channel AC/DC energy monitor. Utilized STM32 for high-speed ADC sampling and power factor calculations, providing real-time analytics to reduce industrial power waste.',
    tags: ['STM32', 'KiCad'],
    image: projectEnergyMonitor,
    alt: 'Custom PCB designed for energy monitoring system',
    id: 'PWR-03',
  },
];
---

<section id="projects" class="relative py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div data-reveal>
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Featured Engineering</h2>
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {projects.map((p, i) => (
        <article
          class="chip-card flex flex-col"
          data-reveal
          data-reveal-delay={String(i)}
        >
          <div class="relative p-3 pb-0">
            <span class="pin-label absolute top-5 right-5 z-10 bg-background px-2 py-1">{p.id}</span>
            <Image
              src={p.image}
              alt={p.alt}
              class="block w-full aspect-video object-cover border border-gridline"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 90vw, 400px"
            />
          </div>
          <div class="flex flex-col flex-1 p-5">
            <h3 class="font-display text-lg font-semibold leading-snug">{p.name}</h3>
            <p class="mt-3 text-text-secondary text-sm leading-relaxed flex-1">{p.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="silkscreen text-trace border border-trace/30 px-3 py-1">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
