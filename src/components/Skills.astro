---
const categories = [
  { name: 'Embedded', items: ['ESP32', 'STM32', 'Arduino', 'Raspberry Pi'] },
  { name: 'Programming', items: ['C/C++', 'Python', 'JavaScript', 'Rust'] },
  { name: 'Frontend', items: ['React', 'Tailwind CSS', 'HTML/CSS'] },
  { name: 'Backend', items: ['Node.js', 'Express', 'MQTT'] },
  { name: 'Database', items: ['MongoDB', 'PostgreSQL', 'InfluxDB'] },
  { name: 'Eng. Tools', items: ['KiCad', 'Altium', 'SolidWorks'] },
  { name: 'Cloud', items: ['AWS IoT', 'Docker', 'Linux'] },
];
---

<section id="skills" class="relative py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div data-reveal>
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Technical Skills</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((cat, i) => (
        <div
          class="chip-card p-6"
          data-reveal
          data-reveal-delay={String(i)}
        >
          <div class="flex items-center justify-between">
            <p class="silkscreen trace">{cat.name}</p>
            <span class="pin-label">PIN-{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <span class="silkscreen border border-gridline px-3 py-1.5 text-text-secondary">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
