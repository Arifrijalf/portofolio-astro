---
const links = [
  { label: 'Email', value: 'arifrijalfadhilah@gmail.com', href: 'mailto:arifrijalfadhilah@gmail.com', icon: 'mail' },
  { label: 'GitHub', value: 'github.com/Arifrijalf', href: 'https://github.com/Arifrijalf', icon: 'github' },
  { label: 'LinkedIn', value: 'linkedin.com/in/arif-rijal-fadhilah', href: 'https://www.linkedin.com/in/arif-rijal-fadhilah', icon: 'linkedin' },
  { label: 'Instagram', value: '@aarifrijal_', href: 'https://www.instagram.com/aarifrijal_/', icon: 'instagram' },
  { label: 'WhatsApp', value: '+62 895-1977-7498', href: 'https://wa.me/6289519777498', icon: 'message-circle' },
];
---

<section id="contact" class="relative py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div data-reveal>
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Contact Protocol</h2>
      <p class="mt-4 text-text-secondary">Direct channels for collaboration and inquiries.</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="space-y-3" data-reveal>
        {links.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
            class="chip-card flex items-center gap-4 px-5 py-4 no-underline"
          >
            <i data-lucide={l.icon} class="inline-block h-5 w-5 text-trace shrink-0"></i>
            <span class="flex-1">
              <span class="silkscreen block text-text-secondary">{l.label}</span>
              <span class="silkscreen text-text-primary">{l.value}</span>
            </span>
            <i data-lucide="arrow-up-right" class="inline-block h-4 w-4 text-text-secondary"></i>
          </a>
        ))}
      </div>

      <form
        id="contact-form"
        action="https://formspree.io/f/mqevrdnv"
        method="POST"
        class="chip-card p-6 flex flex-col gap-4"
        data-reveal
        data-reveal-delay="1"
      >
        <input
          type="text"
          name="_gotcha"
          value=""
          style="display:none; opacity:0; position:absolute; left:-9999px; width:1px; height:1px;"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <input type="hidden" name="_subject" value="Portfolio Contact" />

        <label class="flex flex-col gap-2">
          <span class="silkscreen text-text-secondary">// NAME</span>
          <input
            type="text"
            name="name"
            required
            minlength="3"
            placeholder="Alex"
            class="bg-background border border-gridline px-4 py-3 text-text-primary placeholder:text-text-secondary/50 focus:outline-none focus:border-trace transition-colors"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="silkscreen text-text-secondary">// EMAIL</span>
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="bg-background border border-gridline px-4 py-3 text-text-primary placeholder:text-text-secondary/50 focus:outline-none focus:border-trace transition-colors"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="silkscreen text-text-secondary">// MESSAGE</span>
          <textarea
            name="message"
            required
            minlength="20"
            placeholder="Your message..."
            rows="4"
            class="bg-background border border-gridline px-4 py-3 text-text-primary placeholder:text-text-secondary/50 focus:outline-none focus:border-trace transition-colors resize-none"
          ></textarea>
          <span class="silkscreen text-text-secondary/60">Minimum 20 characters</span>
        </label>

        <button
          type="submit"
          id="submit-btn"
          class="chip-card self-start px-6 py-3 text-trace no-underline"
        >
          <span class="btn-text">Send Message <i data-lucide="send" class="inline-block h-4 w-4"></i></span>
        </button>

        <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>
