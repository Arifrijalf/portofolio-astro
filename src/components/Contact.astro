---
import Icon from "./Icon.astro";
---

<section class="py-section-padding px-margin-page relative" id="contact">
  <div class="mb-12" data-reveal>
    <h2 class="font-headline-md text-[21px] text-text-primary font-bold">
      Contact Protocol
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12" data-reveal data-reveal-delay="1">
    <div>
      <p class="text-[15px] text-text-secondary mb-6">
        Direct channels for collaboration and inquiries.
      </p>
      <ul class="text-[15px] text-text-primary space-y-3">
        <li>
          <a
            class="link-underline hover:opacity-60 transition-opacity flex items-center gap-2"
            href="mailto:arifrijalfadhilah@gmail.com"
            ><Icon name="mail" class="w-4 h-4" />arifrijalfadhilah@gmail.com</a
          >
        </li>
        <li>
          <a
            class="link-underline hover:opacity-60 transition-opacity flex items-center gap-2"
            href="https://www.linkedin.com/in/arif-rijal-fadhilah"
            target="_blank"
            ><Icon name="linkedin" class="w-4 h-4" />LinkedIn</a
          >
        </li>
        <li>
          <a
            class="link-underline hover:opacity-60 transition-opacity flex items-center gap-2"
            href="https://www.instagram.com/aarifrijal_/"
            target="_blank"
            ><Icon name="instagram" class="w-4 h-4" />@aarifrijal_</a
          >
        </li>
      </ul>
    </div>
    <div>
      <form id="contact-form" action="https://formspree.io/f/mqevrdnv" method="POST" class="space-y-6">
        <input type="text" name="_gotcha" class="_gotcha" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_subject" value="Portfolio Contact" />
        <div>
          <label
            class="block text-[15px] text-text-secondary mb-2"
            for="name"
            >Name</label
          >
          <input
            class="w-full bg-transparent border border-border-muted px-4 py-3 text-text-primary focus:outline-none focus:border-text-primary transition-colors"
            id="name"
            name="name"
            placeholder="Alex"
            type="text"
            required
            minlength="3"
          />
        </div>
        <div>
          <label
            class="block text-[15px] text-text-secondary mb-2"
            for="email"
            >Email</label
          >
          <input
            class="w-full bg-transparent border border-border-muted px-4 py-3 text-text-primary focus:outline-none focus:border-text-primary transition-colors"
            id="email"
            name="email"
            placeholder="arif@example.com"
            type="email"
            required
          />
        </div>
        <div>
          <label
            class="block text-[15px] text-text-secondary mb-2"
            for="message"
            >Message</label
          >
          <textarea
            class="w-full bg-transparent border border-border-muted px-4 py-3 text-text-primary focus:outline-none focus:border-text-primary transition-colors h-32 resize-none"
            id="message"
            name="message"
            placeholder="Your message..."
            required
            minlength="20"
          ></textarea>
          <p class="text-[14px] text-text-secondary mt-1">Minimum 20 characters</p>
        </div>
        <div id="form-status"></div>
        <button
          id="submit-btn"
          type="submit"
          class="link-underline font-body-md text-[15px] text-text-primary hover:opacity-60 transition-opacity"
        >
          <span class="btn-text">Send Message</span>
        </button>
      </form>
    </div>
  </div>
</section>
