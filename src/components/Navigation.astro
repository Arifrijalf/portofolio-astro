---
const links = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#certificates', label: 'Certificates' },
  { href: '#github', label: 'GitHub' },
  { href: '#contact', label: 'Contact' },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-40 transition-colors duration-300">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Main">
    <a href="#top" class="silkscreen copper tracking-widest no-underline">ARIF RIJAL FADHILAH</a>

    <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
      {links.map((l) => (
        <li>
          <a href={l.href} class="silkscreen nav-link relative pb-1 no-underline" data-nav>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="mobile-menu-btn"
      class="md:hidden silkscreen trace no-underline p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <i data-lucide="menu" id="menu-open" class="h-5 w-5"></i>
      <i data-lucide="x" id="menu-close" class="h-5 w-5 hidden"></i>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden overflow-hidden max-h-0 transition-all duration-300 bg-panel/95 border-y border-gridline">
    <ul class="flex flex-col gap-1 list-none m-0 p-4">
      {links.map((l) => (
        <li>
          <a href={l.href} class="silkscreen nav-link relative block py-2 px-1 pb-1 no-underline" data-nav>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
