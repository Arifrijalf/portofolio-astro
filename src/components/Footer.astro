---
const socials = [
  { href: 'https://github.com/Arifrijalf', icon: 'github', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/arif-rijal-fadhilah', icon: 'linkedin', label: 'LinkedIn' },
  { href: 'https://wa.me/6289519777498', icon: 'message-circle', label: 'WhatsApp' },
  { href: 'https://www.instagram.com/aarifrijal_/', icon: 'instagram', label: 'Instagram' },
];
---

<footer class="relative border-t border-gridline py-10">
  <div class="max-w-6xl mx-auto px-5 flex flex-col md:flex-row items-center justify-between gap-6">
    <p class="silkscreen text-text-secondary m-0">© 2026 Arif Rijal Fadhilah. Engineered for Precision.</p>
    <ul class="flex gap-6 list-none m-0 p-0">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" class="silkscreen text-text-secondary hover:text-trace transition-colors no-underline" aria-label={s.label}>
            <i data-lucide={s.icon} class="inline-block h-5 w-5"></i>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
