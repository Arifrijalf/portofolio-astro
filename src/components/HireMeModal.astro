---
import Icon from "./Icon.astro";
---

<div
  id="hire-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
>
  <div class="absolute inset-0 bg-void/90"></div>
  <div class="relative w-full max-w-md p-8 modal-content">
    <button
      id="close-modal-btn"
      class="absolute top-4 right-4 text-[15px] text-text-secondary hover:text-text-primary transition-colors"
    >
      Close
    </button>
    <h2 class="font-headline-md text-[21px] text-text-primary font-bold mb-6">Let's Connect</h2>
    <div class="space-y-3">
      <a
        href="mailto:arifrijalfadhilah@gmail.com"
        class="block text-[15px] text-text-primary hover:opacity-60 transition-opacity flex items-center gap-2"
      >
        <Icon name="mail" class="w-4 h-4" />
        arifrijalfadhilah@gmail.com
      </a>
      <a
        href="https://www.linkedin.com/in/arif-rijal-fadhilah"
        target="_blank"
        class="block text-[15px] text-text-primary hover:opacity-60 transition-opacity flex items-center gap-2"
      >
        <Icon name="linkedin" class="w-4 h-4" />
        LinkedIn
      </a>
      <a
        href="https://wa.me/6289519777498"
        target="_blank"
        class="block text-[15px] text-text-primary hover:opacity-60 transition-opacity flex items-center gap-2"
      >
        <Icon name="whatsapp" class="w-4 h-4" />
        WhatsApp
      </a>
      <a
        href="https://www.instagram.com/aarifrijal_/"
        target="_blank"
        class="block text-[15px] text-text-primary hover:opacity-60 transition-opacity flex items-center gap-2"
      >
        <Icon name="instagram" class="w-4 h-4" />
        Instagram
      </a>
    </div>
  </div>
</div>
