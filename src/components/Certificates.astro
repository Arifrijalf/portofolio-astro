---
const certificates = [
  { name: 'AWS Certified IoT Specialty', issuer: 'Amazon Web Services' },
];
---

<section id="certificates" class="relative py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div data-reveal>
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Certifications</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {certificates.map((c) => (
        <div class="chip-card p-6">
          <i data-lucide="award" class="inline-block h-8 w-8 text-copper"></i>
          <p class="mt-4 font-display font-semibold text-lg">{c.name}</p>
          <p class="silkscreen text-text-secondary mt-1">{c.issuer}</p>
          <p class="pin-label mt-4">VALID // VERIFIED</p>
        </div>
      ))}
    </div>
  </div>
</section>
