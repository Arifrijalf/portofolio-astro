---
import BootScreen from '../components/BootScreen.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Arif Rijal Fadhilah — Embedded Systems Engineer & IoT Developer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta
      name="description"
      content="Arif Rijal Fadhilah — Embedded Systems Engineer & IoT Developer. Microcontrollers, real-time control systems, and robust IoT architectures for industrial and consumer applications."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Arif Rijal Fadhilah — Embedded Systems Engineer & IoT Developer" />
    <meta
      property="og:description"
      content="Embedded systems and IoT portfolio by Arif Rijal Fadhilah."
    />
    <meta property="og:url" content="https://arifrijalfadhilah.fun" />
    <meta property="og:image" content="/favicon-v2.png" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/x-icon" href="/favicon-v2.ico" />
    <link rel="icon" type="image/png" href="/favicon-v2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&display=swap"
    />
    <noscript>
      <style>
        .boot-screen { display: none; }
        [data-reveal] { opacity: 1; transform: none; }
      </style>
    </noscript>
  </head>
  <body class="antialiased relative">
    <div class="schematic-grid" aria-hidden="true"></div>
    <div class="cursor-crosshair" id="cursor" aria-hidden="true"></div>
    <BootScreen />
    <Navigation />
    <main class="relative z-10">
      <slot />
    </main>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
